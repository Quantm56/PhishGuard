# Auto detect text files and normalize line endings to LF on commit
* text=auto

# Python and source files
*.py text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.joblib binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pkl binary
