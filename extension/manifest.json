{
  "manifest_version": 3,
  "name": "PhishGuard Pre-Visit URL Scanner",
  "version": "2.0.0",
  "description": "Pre-navigation phishing protection: intercepts visited HTTP/HTTPS URLs before page load and checks them against the local PhishGuard API.",
  "permissions": [
    "declarativeNetRequest",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*/*",
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_title": "PhishGuard Scanner",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "checking.html",
        "checking.js",
        "checking.css",
        "config.js",
        "icons/*",
        "evidence.js"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
