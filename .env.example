# PhishGuard Configuration & Threat Intelligence Keys
# Copy this file to .env and fill in your keys (optional)
# api.py loads .env automatically; restart the server after changes.
# Step-by-step provider setup: API_KEYS.md
# All services degrade gracefully without API keys.

# Server Configuration
HOST=127.0.0.1
PORT=5000

# Optional Threat Intelligence API Keys
# Google Safe Browsing API Key (v4)
# Get a free key at: https://console.cloud.google.com/apis/credentials
GSB_API_KEY=

# VirusTotal API Key (v3)
# Get a free key at: https://www.virustotal.com/gui/user/apiKey
VT_API_KEY=

# abuse.ch URLhaus Auth Key
# Get a free key at: https://auth.abuse.ch
URLHAUS_AUTH_KEY=

# PhishTank Application Key (optional)
# https://phishtank.org/developer_info.php
PHISHTANK_APP_KEY=
